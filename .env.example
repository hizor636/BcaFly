# BcaFly Environment Variables Template (Publicly Safe Example)
# DO NOT place real passwords, JWT secrets, or production database credentials here.

# Frontend Variables
VITE_APP_NAME=BcaFly
VITE_API_URL=http://localhost:8080/api

# Backend Server Configuration (Local Development)
SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bcafly_db
DB_USER=bcafly_app
DB_PASSWORD=your_secure_db_password_here

# JWT Configuration (Change in production)
JWT_SECRET=YourSuperSecretKeyWithMinimum256BitsLengthForHS256Algorithm
JWT_EXPIRATION_MS=86400000

# File Storage Paths (Outside public web root)
STORAGE_UPLOAD_DIR=../storage/uploads
STORAGE_REPORT_DIR=../storage/reports
STORAGE_BACKUP_DIR=../storage/backups
